{
  "port": [
    {
      "name": "bare ports",
      "addrs": ["8080", "8443"],
      "env": "8080=3;8443=4",
      "entries": [
        {"addr": "8080", "fd": 3},
        {"addr": "8443", "fd": 4}
      ]
    },
    {
      "name": "IPv4 and IPv6 hosts",
      "addrs": ["127.0.0.1:8080", "[::1]:8081", "[fe80::1%eth0]:8082"],
      "env": "127.0.0.1:8080=3;[::1]:8081=4;[fe80::1%eth0]:8082=5",
      "entries": [
        {"addr": "127.0.0.1:8080", "fd": 3},
        {"addr": "[::1]:8081", "fd": 4},
        {"addr": "[fe80::1%eth0]:8082", "fd": 5}
      ]
    },
    {
      "name": "unspecified hosts are listed as bare ports",
      "addrs": ["0.0.0.0:8080", "[::]:8081"],
      "env": "8080=3;8081=4",
      "entries": [
        {"addr": "8080", "fd": 3},
        {"addr": "8081", "fd": 4}
      ]
    }
  ]
}
